+class FakeConnection:
+    def __init__(self, response):
+        self.response = response
+        self.sock = None
+        self.calls = []
+        self.closed = False
+
+    def request(self, method, target, headers):
+        self.calls.append((method, target, headers))
+
+    def getresponse(self):
+        return self.response
+
+    def close(self):
+        self.closed = True
+
