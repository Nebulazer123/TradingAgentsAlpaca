# LLM API配置（支持 OpenAI SDK 格式的任意 LLM API）
# 推荐使用阿里百炼平台qwen-plus模型：https://bailian.console.aliyun.com/
# 注意消耗较大，可先进行小于40轮的模拟尝试
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL_NAME=qwen-plus

# ===== 可选 LLM 请求控制（不填则使用默认行为）=====
# OpenRouter 推荐 base_url: https://openrouter.ai/api/v1
# LLM_MODEL_PLATFORM 可选值：OPENAI 或 OPENROUTER；不填时会按 base_url 自动判断
# LLM_MODEL_PLATFORM=OPENROUTER
# LLM_MAX_TOKENS=4096
# LLM_MAX_COMPLETION_TOKENS=4096
# LLM_TEMPERATURE=0.7
# LLM_MODEL_CONFIG_JSON={"max_tokens":4096}
# OpenAI Python SDK 传递 OpenRouter reasoning/provider 等额外字段时使用 extra_body
# LLM_EXTRA_BODY_JSON={"provider":{"allow_fallbacks":true}}
# LLM_REASONING_JSON={"max_tokens":2000}

# ===== ZEP记忆图谱配置 =====
# 每月免费额度即可支撑简单使用：https://app.getzep.com/
ZEP_API_KEY=<zep_key>

# ===== 加速 LLM 配置（可选）=====
# 注意如果不使用加速配置，env文件中就不要出现下面的配置项
LLM_BOOST_API_KEY=your_api_key_here
LLM_BOOST_BASE_URL=your_base_url_here
LLM_BOOST_MODEL_NAME=your_model_name_here
# LLM_BOOST_MODEL_PLATFORM=OPENROUTER
# LLM_BOOST_MAX_TOKENS=4096
# LLM_BOOST_EXTRA_BODY_JSON={}
