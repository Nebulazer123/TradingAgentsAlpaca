{
  "id": "taBuiltInAutomationEvaluation",
  "name": "TA · Built-in Automation Evaluation",
  "nodes": [
    {
      "parameters": {
        "source": "dataTable",
        "dataTableId": {
          "mode": "list",
          "value": "TradingAgents_Automation_Evaluations",
