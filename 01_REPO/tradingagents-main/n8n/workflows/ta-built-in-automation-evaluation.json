            },
            {
              "id": "safety-contract-score",
              "name": "safety_contract_score",
              "value": "={{ $json.metric_safety_contract_score }}",
              "type": "number"
            }
          ]
        }
      },
      "id": "set-evaluation-metrics",
      "name": "Set evaluation metrics",
