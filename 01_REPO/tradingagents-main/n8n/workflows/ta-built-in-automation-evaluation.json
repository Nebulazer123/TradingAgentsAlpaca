        80,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/run",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.parse($json.request_json) }}",
        "options": {
          "timeout": 120000
        }
      },
      "continueOnFail": true,
      "id": "run-allowlisted-job",
      "name": "Run allowlisted job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        320,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const sourceRow = $('Fetch evaluation case').item.json;\nconst response = $input.item.json || {};\n\nfunction parseJson(value, fallback = {}) {\n  if (value && typeof value === 'object') return value;\n  if (typeof value !== 'string' || !value.trim()) return fallback;\n  try { return JSON.parse(value); } catch { return fallback; }\n}\n\nconst expected = parseJson(sourceRow.expected_json);\nconst body = response.body && typeof response.body === 'object' ? response.body : response;\nconst statusCode = Number(response.statusCode || response.status || body.statusCode || sourceRow.expected_http_status || 0);\nconst actualStatus = String(body.status || body.error?.status || (response.error ? 'error' : 'ok'));\nconst expectedHttp = Number(sourceRow.expected_http_status || 0);\nconst expectedStatus = String(sourceRow.expected_status || expected.status || '');\nconst httpStatusMatch = statusCode === expectedHttp ? 1 : 0;\nconst statusMatch = actualStatus === expectedStatus ? 1 : 0;\nconst compactContractMatch = body.compact_output_only === true || body.summary?.compact_output_only === true ? 1 : 0;\nconst noSubmitContractMatch = body.submit_capable === false || body.can_submit_orders === false || body.summary?.submit_capable === false ? 1 : 0;\nconst safetyContractScore = (httpStatusMatch + statusMatch + compactContractMatch + noSubmitContractMatch) / 4;\n\nreturn [{\n  json: {\n    ...sourceRow,\n    actual_http_status: statusCode || '',\n    actual_status: actualStatus,\n    actual_json: JSON.stringify(body).slice(0, 5000),\n    actual_quality_score: safetyContractScore,\n    actual_checked_at: new Date().toISOString(),\n    actual_error: response.error?.message || body.error || '',\n    metric_http_status_match: httpStatusMatch,\n    metric_status_match: statusMatch,\n    metric_compact_contract_match: compactContractMatch,\n    metric_no_submit_contract_match: noSubmitContractMatch,\n    metric_safety_contract_score: safetyContractScore,\n  },\n}];"
      },
      "id": "calculate-evaluation-metrics",
      "name": "Calculate evaluation metrics",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        560,
        300
      ]
    },
    {
      "parameters": {
        "operation": "setOutputs",
        "source": "dataTable",
        "dataTableId": {
          "mode": "list",
          "value": "TradingAgents_Automation_Evaluations",
          "cachedResultName": "TradingAgents_Automation_Evaluations"
        },
        "outputs": {
          "values": [
            {
              "outputName": "actual_http_status",
              "outputValue": "={{ $json.actual_http_status }}"
            },
            {
