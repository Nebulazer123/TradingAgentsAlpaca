# LLM Providers (set the one you use)
OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_CN_API_KEY=
ZHIPU_API_KEY=
ZHIPU_CN_API_KEY=
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
OPENROUTER_API_KEY=

# Optional Azure OpenAI provider config. Azure requires all three routing
# values in addition to AZURE_OPENAI_API_KEY.
AZURE_OPENAI_API_KEY=
#AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
#AZURE_OPENAI_DEPLOYMENT_NAME=your-deployment-name
#OPENAI_API_VERSION=2025-03-01-preview

# Optional: point at a remote Ollama server. When unset, defaults to
# the local instance at http://localhost:11434/v1. Convention follows
# the broader Ollama ecosystem; both the CLI dropdown and programmatic
# client pick this up.
#OLLAMA_BASE_URL=http://your-ollama-host:11434/v1
#
# Optional explicit local research lanes. Keep Windows and Mac separate so
# automations can run quick local work and overnight mule work in parallel.
#TRADINGAGENTS_WINDOWS_OLLAMA_URL=http://127.0.0.1:11434/v1
#TRADINGAGENTS_WINDOWS_RESEARCH_MODEL=gpt-oss:20b
#TRADINGAGENTS_MAC_OLLAMA_URL=http://macbook-pro.tail37edd7.ts.net:11434/v1
#TRADINGAGENTS_MAC_RESEARCH_MODEL=deepseek-r1:14b
#
# Optional model-budget lanes. Scheduled automations keep paid model use off
# until explicitly armed; Codex/ChatGPT remains the out-of-band judgment route.
#TRADINGAGENTS_MODEL_ALLOW_PAID=false
#TRADINGAGENTS_MODEL_ALLOW_OPENAI_PAID=false
#TRADINGAGENTS_MODEL_MAX_COST_USD_PER_RUN=0
#TRADINGAGENTS_GEMINI_RESEARCH_MODEL=gemini-2.5-flash
#TRADINGAGENTS_OPENAI_RESEARCH_MODEL=gpt-5.4-mini
#
# Optional Ollama operating profile for local automation. Keep these opt-in:
# smaller max outputs make hourly/supervisor runs predictable, while
# the recommended 4k Modelfile alias keeps RAM headroom on Windows.
#TRADINGAGENTS_DEEP_THINK_LLM=tradingagents-qwen3-30b-a3b-instruct-2507-q4-4k
#TRADINGAGENTS_QUICK_THINK_LLM=tradingagents-qwen3-30b-a3b-instruct-2507-q4-4k
#TRADINGAGENTS_OLLAMA_TEMPERATURE=0.7
#TRADINGAGENTS_OLLAMA_MAX_COMPLETION_TOKENS=350
#TRADINGAGENTS_OLLAMA_TOP_P=0.8
#TRADINGAGENTS_OLLAMA_PRESENCE_PENALTY=1.5
# TRADINGAGENTS_OLLAMA_EXTRA_BODY_JSON can carry Ollama-specific OpenAI
# compatibility flags when a model supports them.
#TRADINGAGENTS_OLLAMA_EXTRA_BODY_JSON={"think":false}

# Optional: override DEFAULT_CONFIG without editing code.
# Any TRADINGAGENTS_* variable below, when set, replaces the matching key
# in tradingagents/default_config.py. Values are coerced to the type of
# the existing default or explicit env coercer, so "true"/"3" work as expected.
#TRADINGAGENTS_LLM_PROVIDER=openai
#TRADINGAGENTS_DEEP_THINK_LLM=gpt-5.4
#TRADINGAGENTS_QUICK_THINK_LLM=gpt-5.4-mini
#TRADINGAGENTS_LLM_BACKEND_URL=
#TRADINGAGENTS_LLM_TIMEOUT_SECONDS=120
#TRADINGAGENTS_LLM_MAX_RETRIES=2
#TRADINGAGENTS_LLM_MAX_OUTPUT_TOKENS=4096
#TRADINGAGENTS_OUTPUT_LANGUAGE=English
#TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
#TRADINGAGENTS_MAX_RISK_ROUNDS=1
#TRADINGAGENTS_CHECKPOINT_ENABLED=false

# Optional Alpaca paper trading with 10% live mirroring.
# Keep credentials in Windows User environment variables or your private shell,
# not in this example file.
#ALPACA_PAPER_API_KEY=
#ALPACA_PAPER_SECRET_KEY=
#ALPACA_PAPER_API_ENDPOINT=https://paper-api.alpaca.markets
#ALPACA_LIVE_API_KEY=
#ALPACA_LIVE_SECRET_KEY=
#ALPACA_LIVE_API_ENDPOINT=https://api.alpaca.markets
#TRADINGAGENTS_ALPACA_PAPER_ENABLED=false
#TRADINGAGENTS_ALPACA_LIVE_MIRROR_ENABLED=false
#TRADINGAGENTS_PAPER_EXPOSURE_LIMIT=1000
#TRADINGAGENTS_LIVE_MIRROR_RATIO=0.10
#TRADINGAGENTS_LIVE_EXPOSURE_LIMIT=100

# Optional free/supplemental research API keys. These are never required for
# trading. If missing or depleted, research packets mark the source blocked or
# skipped and fall back to cache/free/unmetered routes.
#SEC_USER_AGENT=Your Name your.email@example.com
#FRED_API_KEY=
#BLS_API_KEY=
#BEA_API_KEY=
#EIA_API_KEY=
#ALPHA_VANTAGE_API_KEY=
#FINNHUB_API_KEY=
#MASSIVE_API_KEY=
#FMP_API_KEY=
#EODHD_API_TOKEN=
#MARKETAUX_API_KEY=
#SCRAPINGBEE_API_KEY=
#NEWSAPI_API_KEY=
#TIINGO_API_KEY=
