      "model": "gpt-5.6-luna",
      "reasoning_effort": "medium",
      "notification_policy": "failed_runs_only",
      "prompt_sha256": "106a8fb3141e2a504cc26883d0a5034ab36f313e40ff64c43f6643f0fb64f88b",
      "required_prompt_phrases": ["low-cost status controller", "3:30 AM America/Chicago"],
