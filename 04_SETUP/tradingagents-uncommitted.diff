+def _reddit_time_filter(start_date: str | None, end_date: str | None) -> str:
+    start = _parse_window_date(start_date)
+    end = _parse_window_date(end_date)
+    if start and end:
+        days = max(0, (end - start).days)
+        if days <= 1:
+            return "day"
+        if days <= 7:
+            return "week"
+        if days <= 31:
+            return "month"
+        if days <= 366:
+            return "year"
+        return "all"
+    return "week"
+
