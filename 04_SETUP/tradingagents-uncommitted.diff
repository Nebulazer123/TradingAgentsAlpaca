+PREOPEN_VALIDATION_MAX_AGE = datetime.timedelta(minutes=45)
+
+
+def _latest_preopen_validation_packet(log_dir: Path) -> dict | None:
+    return _read_json_packet(log_dir / "latest-compact.json") or _read_json_packet(
+        log_dir / "latest.json"
