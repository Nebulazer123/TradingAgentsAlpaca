+def _vendor_chain(method: str, vendor_config: str) -> list[str]:
+    configured = [
+        vendor.strip()
+        for vendor in str(vendor_config or "").split(",")
+        if vendor.strip() and vendor.strip() != "default"
+    ]
+    chain: list[str] = []
