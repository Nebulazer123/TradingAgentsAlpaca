+def _decimal_equal(
+    left: object,
+    right: object,
+    *,
+    quantum: Decimal,
+) -> bool:
+    try:
+        return _as_decimal(left).quantize(quantum, rounding=ROUND_DOWN) == _as_decimal(
+            right
+        ).quantize(quantum, rounding=ROUND_DOWN)
+    except Exception:
+        return False
