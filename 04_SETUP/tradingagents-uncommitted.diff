+def _normalize_shadow_symbol(value: object) -> str | None:
+    raw = str(value or "").strip().upper().lstrip("$")
+    if not raw:
+        return None
+    symbol = "".join(ch for ch in raw if ch.isalnum() or ch in {".", "-"})
+    if not symbol or len(symbol) > 12:
