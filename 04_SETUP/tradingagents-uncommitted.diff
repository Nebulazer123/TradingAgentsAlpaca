+                current = Decimal(str(float(close.iloc[-1])))
+                previous = Decimal(str(float(close.iloc[-2]))) if len(close) > 1 else current
+                volume_ratio = _volume_ratio_from_frame(frame, window=4)
+                quote_fresh = daily_bar_is_trade_fresh
